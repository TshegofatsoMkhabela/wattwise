APP_NAME=WattWise API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_CORS_ORIGINS=

# Self-contained demo default. Override with PostgreSQL if needed.
DATABASE_URL=sqlite:///./wattwise_demo.db

# Keep the Copilot Studio Direct Line secret on the backend only.
DIRECTLINE_SECRET=
DIRECTLINE_DOMAIN=https://directline.botframework.com/v3/directline

DEMO_METER_ID=NXM-001-TZN
DEMO_HIGH_USAGE_THRESHOLD_WATTS=1500
DEMO_TARIFF_PER_KWH=3.9
